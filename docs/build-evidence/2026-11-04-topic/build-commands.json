{
  "command-topic.json": [
    "<LLVM_BIN>/clang-cl",
    "/nologo",
    "--target=x86_64-pc-windows-msvc",
    "/std:c++latest",
    "/EHsc",
    "/MD",
    "/O2",
    "/DNDEBUG",
    "/D_CRT_USE_BUILTIN_OFFSETOF",
    "/DUNICODE",
    "/D_UNICODE",
    "/DNOMINMAX",
    "/DWIN32_LEAN_AND_MEAN",
    "/DSPDLOG_USE_STD_FORMAT",
    "/DSPDLOG_WCHAR_TO_UTF8_SUPPORT",
    "-fms-compatibility-version=19.44",
    "/I<BUILD_ROOT>/sdk/crt/include",
    "/I<BUILD_ROOT>/sdk/sdk/include/ucrt",
    "/I<BUILD_ROOT>/sdk/sdk/include/um",
    "/I<BUILD_ROOT>/sdk/sdk/include/shared",
    "/I<BUILD_ROOT>/sdk/sdk/include/winrt",
    "/I<BUILD_ROOT>/deps/commonlibf4/include",
    "/I<BUILD_ROOT>/deps/commonlibf4/lib/commonlib-shared/include",
    "/I<BUILD_ROOT>/deps/spdlog/include",
    "/I<BUILD_ROOT>/native/port240/http/include",
    "/I<BUILD_ROOT>/native/port240/include",
    "/I<BUILD_ROOT>/native/port240/plugin",
    "/I<BUILD_ROOT>/generated",
    "/FI<BUILD_ROOT>/native/upstream/TopicInfoPatcher/src/PCH.h",
    "/c",
    "<BUILD_ROOT>/native/upstream/TopicInfoPatcher/src/main.cpp",
    "/Fo<BUILD_ROOT>/obj/topic.obj"
  ],
  "command-crosshair.json": [
    "<LLVM_BIN>/clang-cl",
    "/nologo",
    "--target=x86_64-pc-windows-msvc",
    "/std:c++latest",
    "/EHsc",
    "/MD",
    "/O2",
    "/DNDEBUG",
    "/D_CRT_USE_BUILTIN_OFFSETOF",
    "/DUNICODE",
    "/D_UNICODE",
    "/DNOMINMAX",
    "/DWIN32_LEAN_AND_MEAN",
    "/DSPDLOG_USE_STD_FORMAT",
    "/DSPDLOG_WCHAR_TO_UTF8_SUPPORT",
    "-fms-compatibility-version=19.44",
    "/I<BUILD_ROOT>/sdk/crt/include",
    "/I<BUILD_ROOT>/sdk/sdk/include/ucrt",
    "/I<BUILD_ROOT>/sdk/sdk/include/um",
    "/I<BUILD_ROOT>/sdk/sdk/include/shared",
    "/I<BUILD_ROOT>/sdk/sdk/include/winrt",
    "/I<BUILD_ROOT>/deps/commonlibf4/include",
    "/I<BUILD_ROOT>/deps/commonlibf4/lib/commonlib-shared/include",
    "/I<BUILD_ROOT>/deps/spdlog/include",
    "/I<BUILD_ROOT>/native/port240/http/include",
    "/I<BUILD_ROOT>/native/port240/include",
    "/I<BUILD_ROOT>/native/port240/plugin",
    "/I<BUILD_ROOT>/generated",
    "/FI<BUILD_ROOT>/native/upstream/TopicInfoPatcher/src/PCH.h",
    "-ferror-limit=0",
    "/c",
    "<BUILD_ROOT>/native/upstream/TopicInfoPatcher/src/Crosshair.cpp",
    "/Fo<BUILD_ROOT>/obj/crosshair.obj"
  ],
  "link-command.json": [
    "<LLVM_BIN>/lld-link",
    "/nologo",
    "/dll",
    "/machine:x64",
    "/opt:ref",
    "/opt:icf",
    "/incremental:no",
    "/timestamp:0",
    "/out:<BUILD_ROOT>/staging/TopicInfoPatcher.dll",
    "/libpath:<BUILD_ROOT>/sdk/crt/lib/x86_64",
    "/libpath:<BUILD_ROOT>/sdk/sdk/lib/ucrt/x86_64",
    "/libpath:<BUILD_ROOT>/sdk/sdk/lib/um/x86_64",
    "<BUILD_ROOT>/obj/topic.obj",
    "<BUILD_ROOT>/obj/crosshair.obj",
    "<DEPENDENCY_ARCHIVE>",
    "kernel32.lib",
    "advapi32.lib",
    "bcrypt.lib",
    "d3d11.lib",
    "d3dcompiler.lib",
    "dbghelp.lib",
    "dxgi.lib",
    "ole32.lib",
    "shell32.lib",
    "user32.lib",
    "version.lib",
    "ws2_32.lib"
  ]
}
