{
  "$comment": "Copy to <Mantella user folder>/openclaw_companion.json (or point MANTELLA_OPENCLAW_CONFIG at it). No secrets here: the Gateway token is read from the env var NAMED in token_env. Ships disabled with the offline mock transport.",
  "enabled": false,
  "transport": "mock",
  "characters": ["Kalli"],
  "agent_id": "fallout-kalli",
  "base_url": "http://127.0.0.1:18789/v1",
  "token_env": "OPENCLAW_MANTELLA_TOKEN",
  "session_scope": "conversation",
  "session_namespace": "mantella-fo4",
  "message_channel": "mantella",
  "allow_non_loopback": false,
  "fallback_to_direct": true,
  "connect_timeout_s": 5.0,
  "first_token_timeout_s": 45.0,
  "read_timeout_s": 60.0,
  "max_retries": 2,
  "retry_backoff_s": 0.5,
  "max_retry_after_s": 5.0,
  "busy_status_is_pre_acceptance": false,
  "recap_messages": 12,
  "max_message_chars": 1200,
  "max_context_chars": 6000,
  "max_reply_chars": 4000,
  "max_tokens": 300
}
